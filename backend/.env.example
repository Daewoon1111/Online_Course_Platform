# Copy to backend/.env and fill in. Never commit .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouter: create a key at https://openrouter.ai/keys
# Choose a model on https://openrouter.ai/models that supports "tools" and "structured_outputs".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Max AI calls per user (or IP) - chatbot, lesson Q&A, quiz
AI_RATE=30/hour

# PostgreSQL (leave POSTGRES_DB empty to use SQLite)
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
